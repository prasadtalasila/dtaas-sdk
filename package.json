{
  "name": "@into-cps-association/dtaas-sdk",
  "version": "0.1.0",
  "description": "Contract for DTaaS web client extensions: extension and host-service types, visualisation schemas, validation helpers, a test harness and a shareable ESLint config.",
  "author": "prasadtalasila <prasad.talasila@gmail.com> (http://prasad.talasila.in/)",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "dtaas",
    "digital twins",
    "extensions",
    "sdk",
    "visualisation"
  ],
  "homepage": "https://github.com/INTO-CPS-Association/dtaas-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTO-CPS-Association/dtaas-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js",
      "default": "./dist/eslint/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json && node scripts/resolve-declaration-paths.mjs dist",
    "typecheck": "tsc --project tsconfig.eslint.json --noEmit",
    "clean": "node --eval \"const { rmSync } = require('node:fs'); ['coverage', 'dist'].forEach((path) => rmSync(path, { recursive: true, force: true }))\"",
    "format": "prettier --write \"*.{ts,mjs,json,md}\" \"{src,tests,examples}/**/*.{ts,tsx,mjs,json,md}\" \"docs/*.md\"",
    "format:check": "prettier --check \"*.{ts,mjs,json,md}\" \"{src,tests,examples}/**/*.{ts,tsx,mjs,json,md}\" \"docs/*.md\"",
    "syntax": "eslint . --fix",
    "lint": "eslint .",
    "test:unit": "jest --config jest.config.json --coverageDirectory=coverage/unit tests/unit --setupFilesAfterEnv ./tests/unit/jest.setup.ts",
    "test:int": "jest --config jest.config.json --coverageDirectory=coverage/int tests/integration --setupFilesAfterEnv ./tests/integration/jest.setup.ts",
    "test:coverage": "jest --config jest.config.json --coverageDirectory=coverage/all --coverageThreshold='{\"global\":{\"lines\":90,\"statements\":90,\"functions\":90,\"branches\":85}}' tests/unit tests/integration --setupFilesAfterEnv ./tests/unit/jest.setup.ts",
    "test:e2e": "yarn build && node tests/e2e/smoke-package.mjs",
    "test:all": "yarn test:coverage && yarn test:e2e",
    "prep": "qlty fmt && yarn format && yarn syntax && qlty check --fix && yarn typecheck && yarn test:all",
    "validate:package": "yarn typecheck && yarn test:e2e"
  },
  "// build": "tsup emits ESM JavaScript for the four entries; tsc emits declarations; tsc-alias rewrites src/* aliases to relative paths; resolve-declaration-paths adds the .js extensions Node ESM consumers need.",
  "// test:coverage": "Runs unit and integration tests together and enforces the coverage gate that matches .codecov.yml.",
  "// test:e2e": "Builds, packs and installs the tarball into a clean project, then imports every subpath.",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "peerDependencies": {
    "@testing-library/react": ">=16",
    "eslint": ">=9",
    "react": ">=19",
    "react-router-dom": ">=7",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@reduxjs/toolkit": "2.10.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "9.39.5",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.7.0",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "prettier": "3.9.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.4",
    "ts-jest": "29.4.11",
    "tsc-alias": "1.9.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "resolutions": {
    "esbuild": "0.28.1"
  }
}
