{
  "preset": "ts-jest",
  "testEnvironment": "jsdom",
  "transform": {
    "^.+\\.[tj]sx?$": [
      "ts-jest",
      {
        "allowJs": true,
        "tsconfig": {
          "jsx": "react-jsx",
          "noUnusedLocals": false,
          "types": ["jest", "node"],
          "esModuleInterop": true,
          "paths": {
            "src/*": ["./src/*"],
            "tests/*": ["./tests/*"]
          }
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@into-cps-association/dtaas-sdk|three/examples)/)"
  ],
  "collectCoverage": true,
  "coverageReporters": ["text", "cobertura", "clover", "lcov", "json"],
  "collectCoverageFrom": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.types.ts",
    "!src/**/index.ts",
    "!src/converter/generated/**"
  ],
  "testTimeout": 15000,
  "modulePathIgnorePatterns": ["dist"],
  "testRegex": "/tests/.*\\.test\\.tsx?$",
  "moduleDirectories": ["node_modules"],
  "modulePaths": ["<rootDir>"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^tests/(.*)$": "<rootDir>/tests/$1",
    "\\.(css|less|scss)$": "<rootDir>/tests/__mocks__/styleMock.ts"
  },
  "verbose": true,
  "maxWorkers": 3,
  "setupFiles": ["<rootDir>/tests/setupTests.ts"],
  "setupFilesAfterEnv": ["<rootDir>/tests/jest.setup.ts"]
}
